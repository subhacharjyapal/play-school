// Prisma schema for Little Stars Play School
// SQLite is used for local dev. Enums are represented as strings with
// application-level (Zod) validation so the schema can move to PostgreSQL
// later by swapping `String` for native enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth & Profiles ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String // PARENT | TEACHER | ADMIN
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  parent            Parent?
  teacher           Teacher?
  reviewedApps      Application[]       @relation("ApplicationReviewer")
  passwordResets    PasswordResetToken[]
  contactMessages   ContactMessage[]    @relation("ContactReader")
  announcementsRead Announcement[]      @relation("AnnouncementAuthor")
  galleryImages     GalleryImage[]      @relation("GalleryUploader")
  testsCreated      Test[]              @relation("TestAuthor")
  attendanceMarked  Attendance[]        @relation("AttendanceMarker")
}

model Parent {
  id                String   @id @default(cuid())
  userId            String   @unique
  fullName          String
  phone             String
  address           String
  emergencyContact  String?
  relationshipLabel String? // e.g. "Mother", "Father", "Guardian"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]
}

model Teacher {
  id            String   @id @default(cuid())
  userId        String   @unique
  fullName      String
  phone         String?
  qualification String?
  photoUrl      String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  classrooms      Classroom[]
  progressReports ProgressReport[]
}

// ---------- Academic ----------

model Classroom {
  id        String  @id @default(cuid())
  name      String // e.g. "LKG - Blue"
  program   String // PLAYGROUP | NURSERY | LKG | UKG
  teacherId String?

  teacher   Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  students  Student[]
  tests     Test[]
}

model Student {
  id          String    @id @default(cuid())
  fullName    String
  dob         DateTime
  gender      String // MALE | FEMALE | OTHER
  photoUrl    String?
  program     String // PLAYGROUP | NURSERY | LKG | UKG
  isActive    Boolean   @default(true)
  classroomId String?
  parentId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classroom      Classroom?      @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  parent         Parent          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  testResults    TestResult[]
  progressReports ProgressReport[]
  attendance     Attendance[]
  application    Application?
}

model Test {
  id          String    @id @default(cuid())
  title       String
  subject     String
  date        DateTime
  maxMarks    Int
  term        String // TERM1 | TERM2 | TERM3
  academicYear String // e.g. "2025-26"
  classroomId String
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("TestAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  results     TestResult[]
}

model TestResult {
  id            String  @id @default(cuid())
  testId        String
  studentId     String
  marksObtained Int
  grade         String // e.g. "A+", "B"
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
}

model ProgressReport {
  id               String  @id @default(cuid())
  studentId        String
  teacherId        String?
  term             String // TERM1 | TERM2 | TERM3
  academicYear     String // e.g. "2025-26"
  attendancePct    Float
  languageRating   Int // 1-5
  mathRating       Int // 1-5
  motorRating      Int // 1-5
  socialRating     Int // 1-5
  creativityRating Int // 1-5
  disciplineRating Int // 1-5
  teacherRemarks   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, term, academicYear])
}

model Attendance {
  id          String   @id @default(cuid())
  studentId   String
  date        DateTime // date-only, normalized to UTC midnight
  status      String // PRESENT | ABSENT | LATE
  markedById  String?
  createdAt   DateTime @default(now())

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
}

// ---------- Admissions ----------

model Application {
  id                String    @id @default(cuid())
  childFullName     String
  dob               DateTime
  gender            String // MALE | FEMALE | OTHER
  program           String // PLAYGROUP | NURSERY | LKG | UKG
  parentName        String
  relationship      String
  phone             String
  email             String
  address           String
  emergencyContact  String
  medicalNotes      String?
  message           String?
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById      String?
  reviewedAt        DateTime?
  studentId         String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reviewedBy User?    @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  student    Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

// ---------- Site content ----------

model GalleryImage {
  id           String   @id @default(cuid())
  title        String
  category     String // EVENT | CLASSROOM | SPORTS | FESTIVAL | ACTIVITY
  imageUrl     String
  publicId     String? // storage key for swapping to S3 later
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation("GalleryUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  eventDate   DateTime?
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User? @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  readById  String?
  createdAt DateTime @default(now())

  readBy User? @relation("ContactReader", fields: [readById], references: [id], onDelete: SetNull)
}

// ---------- Password reset ----------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String // sha256 of the raw token; raw token is only emailed
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
