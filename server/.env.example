# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# SQLite for local dev. For PostgreSQL use e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/littlestars?schema=public"
DATABASE_URL="file:./dev.db"

# ---- Auth ----
# Change these in production! Use long random strings.
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE=false

# ---- CORS ----
# Frontend origin allowed to call the API with credentials
CORS_ORIGIN="http://localhost:5173"

# ---- Email ----
# If SMTP_HOST is left empty, a console-logging mock email service is used (dev).
EMAIL_FROM="Little Stars Play School <no-reply@littlestars.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Uploads ----
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5

# Dev-only: set to true to disable rate limiting locally (e.g. for automated
# smoke tests). NEVER enable in production.
DISABLE_RATE_LIMIT=false
